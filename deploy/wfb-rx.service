[Unit]
Description=PDL (wfb-ng) : réception, avec relais de statistiques
# Wants et non Requires : avec Requires, un echec de wfb-iface abandonne le job
# de demarrage de celui-ci, et Restart= ne s'applique qu'APRES un demarrage
# reussi — donc l'unite ne revient jamais. Avec Wants, elle demarre quand meme,
# echoue tant que l'interface n'est pas prete, et son Restart la ramene seule.
Wants=wfb-iface.service
After=wfb-iface.service
# Un lien critique ne doit pas pouvoir s'abandonner lui-meme. Sans ceci, cinq
# echecs en dix secondes (soit deux a trois minutes de boot difficile avec
# RestartSec=2) suffisent a mettre l'unite en echec DEFINITIF.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/default/wfb
ExecStart=/home/jules/droneMk2/deploy/wfb-rx.sh
# Lien critique : on relance toujours. Une coupure déclenche les procédures
# d'urgence du drone, donc rester mort est le pire des états.
Restart=always
RestartSec=2
User=jules
# Nécessite CAP_NET_RAW pour PF_PACKET. Les binaires la portent déjà
# (setcap cap_net_raw+ep), ce qui évite de faire tourner tout ceci en root.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
# Avec AmbientCapabilities, le service fonctionne meme si le setcap sur les
# binaires n'a pas ete fait : une dependance de moins a l'installation.

[Install]
WantedBy=multi-user.target
